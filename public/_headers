# Cloudflare Pages response headers.
# Vite copies public/ verbatim into dist/, so this ships with the build.
#
# Every file under /assets/ is content-hashed by Vite (index-Ce2xaJt7.js), so a
# new build always produces new URLs. That makes a one-year immutable cache
# safe — the browser can never be stuck on a stale chunk.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML is the one file whose URL never changes, so it must always be
# revalidated or a deploy would not reach returning visitors.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# No Content-Security-Policy on purpose. The map pulls tiles from several
# third-party origins (OpenStreetMap, ArcGIS, OpenFreeMap, OpenTopoMap) and
# Leaflet/MapLibre rely on inline styles, blob: and data: URLs. A CSP strict
# enough to be worth having would break the map, and one loose enough to pass
# would not be worth shipping. Revisit per-origin if that changes.
